import os
import discord
from discord.ext import commands
from google import genai
from dotenv import load_dotenv

# 讀取 .env 檔案
load_dotenv()

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
DISCORD_BOT_TOKEN = os.getenv("DISCORD_BOT_TOKEN")

# 1. 初始化 Gemini API Client
gemini_client = genai.Client(api_key=GEMINI_API_KEY)

# 2. 設定 Discord Bot 權限
intents = discord.Intents.default()
intents.message_content = True  # 必須開啟讀取訊息權限
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"Agent 已上線：{bot.user}")

@bot.command()
async def count_chat(ctx, limit: int = 100):
    """
    指令格式：!count_chat 100
    抓取頻道最近 100 條訊息，並讓 Gemini 做統計與分析
    """
    await ctx.send(f"正在讀取最近 {limit} 條聊天紀錄並進行統計...")
    
    # 抓取 Discord 頻道紀錄
    messages = []
    async for msg in ctx.channel.history(limit=limit):
        if not msg.author.bot:  # 忽略機器人訊息
            messages.append(f"{msg.author.name}: {msg.content}")
            
    if not messages:
        await ctx.send("沒有找到有效的成員聊天紀錄。")
        return

    chat_logs = "\n".join(messages)

    # 設計給 Gemini 的 Agent Prompt
    prompt = f"""
    你是一個 Discord 數據分析 Agent。請分析以下成員的聊天紀錄，並完成以下任務：
    1. 統計每位成員發言的總次數（排序）。
    2. 總結這段聊天紀錄的主要討論話題（1-3 點）。
    3. 找出最活躍的成員與特別值得注意的互動。

    聊天紀錄內容如下：
    ---
    {chat_logs}
    ---
    """

    try:
        # 先嘗試主模型
        response = gemini_client.models.generate_content(
            model="gemini-3.8-flash",
            contents=prompt,
        )
        await ctx.send(response.text)
    except Exception as e:
        if "503" in str(e):
            await ctx.send("主模型繁忙，自動切換至輕量版模型 (gemini-3.8-flash-lite) 重試...")
            try:
                # 備用切換至 Flash-Lite
                response = gemini_client.models.generate_content(
                    model="gemini-3.5-flash-lite",
                    contents=prompt,
                )
                await ctx.send(response.text)
            except Exception as backup_e:
                await ctx.send(f"備用模型亦發生錯誤：{backup_e}")
        else:
            await ctx.send(f"分析時發生錯誤：{e}")

# 執行 Bot
if __name__ == "__main__":
    bot.run(DISCORD_BOT_TOKEN)